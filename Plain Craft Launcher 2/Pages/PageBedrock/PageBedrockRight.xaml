<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL" x:Class="PageBedrockRight" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10,25,25">
            <local:MyCard Title="Minecraft 基岩版" Margin="0,15,0,15">
                <StackPanel Margin="21,40,21,20">
                    <TextBlock Text="启动当前 Windows 用户已安装的 Minecraft for Windows。" TextWrapping="Wrap" />
                    <TextBlock x:Name="LabStatus" Margin="0,14,0,8" Text="正在检查安装状态…" TextWrapping="Wrap" />
                    <local:MyComboBox x:Name="ComboInstall" Height="34" IsEnabled="False" />
                    <TextBlock x:Name="LabDetails" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <local:MyButton x:Name="BtnStart" Text="启动游戏" ColorType="Highlight" Height="35" MinWidth="120" IsEnabled="False" />
                        <local:MyButton x:Name="BtnRefresh" Text="刷新安装状态" Height="35" MinWidth="130" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="内容管理" Margin="0,0,0,15">
                <StackPanel Margin="21,40,21,20">
                    <TextBlock Text="选择或拖入 .mcpack / .mcaddon 文件，查看包信息。" TextWrapping="Wrap" />
                    <TextBlock x:Name="LabPackInfo" Text="附加包导入和世界配置将在完成数据保护验证后开放。" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnAddons" Text="预览附加包" Height="35" MinWidth="120" />
                        <local:MyButton x:Name="BtnFolder" Text="预览包文件夹" Height="35" MinWidth="120" Margin="10,0,0,0" />
                        <local:MyButton x:Name="BtnWorlds" Text="数据与世界" Height="35" MinWidth="120" Margin="10,0,0,0" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardWorlds" Title="数据目录与内容" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="21,40,21,20">
                    <TextBlock x:Name="LabRootsStatus" TextWrapping="Wrap" Text="请先确认属于目标游戏账户的数据目录。" />
                    <local:MyComboBox x:Name="ComboRoots" Height="34" Margin="0,10,0,0" IsEnabled="False" />
                    <local:MyButton x:Name="BtnReadWorlds" Text="读取世界列表" Height="35" Width="130" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" />
                    <TextBlock x:Name="LabWorldStatus" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <local:MyComboBox x:Name="ComboWorlds" Height="34" Margin="0,10,0,0" IsEnabled="False" />
                    <TextBlock x:Name="LabWorldDetails" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <local:MyButton x:Name="BtnBackup" Text="备份所选世界" Height="35" Width="130" IsEnabled="False" />
                        <local:MyButton x:Name="BtnRestore" Text="恢复为新世界" Height="35" Width="130" Margin="10,0,0,0" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock Text="已安装的附加包" FontSize="14" Margin="0,20,0,0" />
                    <local:MyButton x:Name="BtnListAddons" Text="读取附加包" Height="35" Width="130" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" />
                    <TextBlock x:Name="LabAddonStatus" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <local:MyComboBox x:Name="ComboAddons" Height="34" Margin="0,10,0,0" IsEnabled="False" />
                    <TextBlock x:Name="LabAddonDetails" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="附加包事务恢复（实验性）" FontSize="14" Margin="0,20,0,0" />
                    <TextBlock Text="仅列出此数据目录中由启动器保留的事务；状态基于路径，恢复时会重新校验内容。" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <local:MyButton x:Name="BtnListTransactions" Text="读取事务记录" Height="35" Width="130" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" />
                    <TextBlock x:Name="LabTransactionStatus" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <local:MyComboBox x:Name="ComboTransactions" Height="34" Margin="0,10,0,0" IsEnabled="False" />
                    <local:MyButton x:Name="BtnRollbackTransaction" Text="移回暂存目录" Height="35" Width="130" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
